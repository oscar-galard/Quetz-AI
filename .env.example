# Quetz-AI configuration
# Copy this to .env and fill in your keys.

# --- Planner (cloud = fast decomposition) ---
PLANNER_MODE=cloud
PLANNER_MODEL=gemini-2.0-flash
CLOUD_API_KEY=
CLOUD_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- Executor (local = free code generation) ---
EXECUTOR_MODE=local
EXECUTOR_MODEL=qwen3-coder_IQ4XS:latest

# --- Context ---
CONTEXT_TOKEN_BUDGET=6000

# --- Execution ---
DEFAULT_MAX_ATTEMPTS=5
AUTO_COMMIT=false

# --- LangSmith (optional) ---
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=quetz-ai
