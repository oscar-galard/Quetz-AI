# Quetz-AI configuration

# Model Mode: 'local' (Ollama) or 'cloud' (OpenAI-compatible APIs like OpenAI/ChatGPT, DeepSeek)
MODE=local

# Local Ollama model to use (default: qwen3-coder_IQ4XS:latest)
LOCAL_MODEL=qwen3-coder_IQ4XS:latest

# --- Cloud Model Configuration ---
# API key for the cloud provider
CLOUD_API_KEY=your_cloud_api_key_here
# Name of the cloud model (default: gpt-4o)
CLOUD_MODEL=gpt-4o
# Optional base URL for OpenAI-compatible cloud providers (e.g., DeepSeek: https://api.deepseek.com)
CLOUD_BASE_URL=

# LangSmith Observability Configuration (Optional)
# Set to 'true' to enable tracing of your runs to LangSmith
LANGCHAIN_TRACING_V2=false
# Your LangSmith API key
LANGCHAIN_API_KEY=your_langsmith_api_key_here
# The name of the project/workspace under which to record runs (default: quetz-ai)
LANGCHAIN_PROJECT=quetz-ai
